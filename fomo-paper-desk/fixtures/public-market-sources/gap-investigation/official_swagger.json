    "/v1/tokens/{id}/report": {
      "get": {
        "description": "Generate a detailed report for given token mint",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "Tokens"
        ],
        "summary": "Get full token report",
        "parameters": [
          {
            "type": "string",
            "description": "Token mint address",
            "name": "id",
            "in": "path",
            "required": true
          },
          {
            "type": "boolean",
            "description": "Force report regeneration (paid API keys only)",
            "name": "refresh",
            "in": "query"
          }
        ],
        "responses": {
          "200": {

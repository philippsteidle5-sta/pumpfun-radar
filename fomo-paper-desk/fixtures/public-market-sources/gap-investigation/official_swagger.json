    "/v1/tokens/verified": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "Tokens that have passed RugCheck's own verification review and whose verification is still active. A token drops out of this list as soon as its verification is revoked.\n\nThis covers RugCheck's own verification only. Tokens marked verified through an external registry are not included here, so treat this list as a complement to any third-party verified set rather than a superset of it.\n\nResults are newest-verified first. Paginate by taking `nextCursor` from a response and sending it back as the `cursor` parameter on the next call. When a response omits `nextCursor`, you have reached the last page. The cursor encodes a position rather than an offset, so pages stay stable while new tokens are verified \u2014 you will not see duplicates or skipped entries mid-scan. Cursors are opaque; do not construct or modify them.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "Tokens"
        ],
        "summary": "List platform-verified tokens",
        "parameters": [
          {
            "type": "string",
            "description": "Pagination cursor: the nextCursor value from a previous response. Omit for the first page.",
            "name": "cursor",
            "in": "query"
          },
          {
            "type": "integer",
            "description": "Results per page, 1-100 (default 20)",
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Verified tokens, plus nextCursor when more pages remain",
            "schema": {
              "$ref": "#/definitions/dto.VerifiedTokenListResponse"
            }
          },
          "400": {
            "description": "Invalid limit or malformed cursor",
            "schema": {
              "$ref": "#/definitions/dto.ErrorResponse"
            }
          },
          "401": {
            "description": "Paid-plan API key required",
            "schema": {
              "$ref": "#/definitions/dto.ErrorResponse"
            }
          }
        }
      }
    },

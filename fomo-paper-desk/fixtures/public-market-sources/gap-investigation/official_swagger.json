    "/v1/search": {
      "get": {
        "description": "Full-text search over token name, symbol, and mint address, ranked so\nlegitimate tokens beat impersonators. An empty q returns a trust/activity-ranked browse listing.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "Tokens"
        ],
        "summary": "Search tokens",
        "parameters": [
          {
            "type": "string",
            "description": "Search query (name, symbol, or mint address)",
            "name": "q",
            "in": "query"
          },
          {
            "type": "integer",
            "description": "Max results (default 20, capped at 50)",
            "name": "limit",
            "in": "query"
          },
          {
            "type": "integer",
            "description": "Filter out tokens with a risk score above this value (default 0, unfiltered)",
            "name": "maxScore",
            "in": "query"
          },
          {
            "type": "integer",
            "description": "Page number for results (default 0)",
            "name": "page",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked search results",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/dto.SearchResult"
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "schema": {
              "$ref": "#/definitions/dto.ErrorResponse"
            }
          },
          "500": {
            "description": "Search failed",
            "schema": {
              "$ref": "#/definitions/dto.ErrorResponse"
            }
          }
        }
      }
    },
